    <script>
        // Set dynamic current year
        document.getElementById('year').textContent = new Date().getFullYear();

        // Theme Toggle Setup (Normal / Light Mode Default)
        const themeToggleBtns = [document.getElementById('theme-toggle'), document.getElementById('theme-toggle-mobile')];
        
        function applyTheme(isDark) {
            if (isDark) {
                document.documentElement.classList.add('dark');
                localStorage.setItem('portfolio_theme', 'dark');
            } else {
                document.documentElement.classList.remove('dark');
                localStorage.setItem('portfolio_theme', 'light');
            }
        }

        // Initialize Light Mode Default
        const storedTheme = localStorage.getItem('portfolio_theme');
        if (storedTheme === 'dark') {
            applyTheme(true);
        } else {
            applyTheme(false); // Default is Light/Normal Mode
        }

        themeToggleBtns.forEach(btn => {
            if(btn) {
                btn.addEventListener('click', () => {
                    const isDark = document.documentElement.classList.contains('dark');
                    applyTheme(!isDark);
                });
            }
        });

        // Mobile Navigation Menu Drawer
        const mobileMenuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        const mobileNavLinks = document.querySelectorAll('.mobile-nav-link');

        if(mobileMenuBtn && mobileMenu) {
            mobileMenuBtn.addEventListener('click', () => {
                mobileMenu.classList.toggle('hidden');
            });
            mobileNavLinks.forEach(link => {
                link.addEventListener('click', () => {
                    mobileMenu.classList.add('hidden');
                });
            });
        }

        // Typing Effect Loop
        const typedTextElement = document.getElementById('typed-text');
        const phrases = ['Modern Web Applications', 'Scalable Backend APIs', 'Responsive User Interfaces'];
        let phraseIndex = 0;
        let letterIndex = 0;
        let isDeleting = false;

        function typeLoop() {
            if (!typedTextElement) return;
            const currentPhrase = phrases[phraseIndex];
            
            if (isDeleting) {
                typedTextElement.textContent = currentPhrase.substring(0, letterIndex - 1);
                letterIndex--;
            } else {
                typedTextElement.textContent = currentPhrase.substring(0, letterIndex + 1);
                letterIndex++;
            }

            let speed = isDeleting ? 30 : 70;

            if (!isDeleting && letterIndex === currentPhrase.length) {
                speed = 2000;
                isDeleting = true;
            } else if (isDeleting && letterIndex === 0) {
                isDeleting = false;
                phraseIndex = (phraseIndex + 1) % phrases.length;
                speed = 400;
            }

            setTimeout(typeLoop, speed);
        }
        typeLoop();

        // Project Filtering Logic
        const filterBtns = document.querySelectorAll('.project-filter-btn');
        const projectCards = document.querySelectorAll('.project-card');

        filterBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                filterBtns.forEach(b => {
                    b.classList.remove('bg-brand-600', 'text-white');
                    b.classList.add('bg-white', 'dark:bg-dark-card', 'text-slate-600', 'dark:text-slate-300');
                });
                btn.classList.remove('bg-white', 'dark:bg-dark-card', 'text-slate-600', 'dark:text-slate-300');
                btn.classList.add('bg-brand-600', 'text-white');

                const filter = btn.getAttribute('data-filter');

                projectCards.forEach(card => {
                    if (filter === 'all' || card.getAttribute('data-category') === filter) {
                        card.style.display = 'block';
                    } else {
                        card.style.display = 'none';
                    }
                });
            });
        });

        // Contact Form Submission & Toast Feedback
        const contactForm = document.getElementById('contact-form');
        const toast = document.getElementById('toast');

        if (contactForm && toast) {
            contactForm.addEventListener('submit', (e) => {
                e.preventDefault();
                
                toast.classList.remove('translate-y-20', 'opacity-0');
                toast.classList.add('translate-y-0', 'opacity-100');

                setTimeout(() => {
                    toast.classList.remove('translate-y-0', 'opacity-100');
                    toast.classList.add('translate-y-20', 'opacity-0');
                }, 3000);

                contactForm.reset();
            });
        }
    </script>
